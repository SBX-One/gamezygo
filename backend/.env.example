APP_NAME=Gamezygo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
# Use DB_HOST=postgres inside Docker containers, and DB_HOST=127.0.0.1 if running commands from your host machine
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gamezygo
DB_USERNAME=dev_admin
DB_PASSWORD=SecretPGDBPassword

# Cache & Queue Configuration
# Use REDIS_HOST=redis inside Docker containers, and REDIS_HOST=127.0.0.1 if running commands from your host machine
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Midtrans configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google-login/callback

# AWS S3 Cloud Storage Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=gamezygo-bucket
