# ==========================================
# Gamezygo Frontend Environment Configuration
# ==========================================

# Decoupled Laravel REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Midtrans Payment Gateway (Snap SDK Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Google OAuth 2.0 Client ID (Frontend authentication)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
